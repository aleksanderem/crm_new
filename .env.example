# Convex (required)
CONVEX_DEPLOYMENT=
VITE_CONVEX_URL=
CONVEX_SITE_URL=

# Auth
AUTH_RESEND_KEY=
AUTH_EMAIL=
HOST_URL=
SITE_URL=

# Email (Resend)
RESEND_API_KEY=
RESEND_FROM=

# Stripe (optional for billing)
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# Google OAuth (optional for Gmail integration)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=

# Supabase (self-hosted — used by JWT bridge for RLS-scoped queries)
SUPABASE_URL=http://localhost:8000
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_JWT_SECRET=

# Supabase (frontend — exposed to Vite, used by supabase-js client)
VITE_SUPABASE_URL=http://localhost:8000

# App URL
APP_URL=
