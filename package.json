{
  "name": "convex-saas",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "engines": {
    "node": ">=20.0.0",
    "npm": ">=10.0.0"
  },
  "overrides": {
    "@primereact/core": {
      "react": "$react"
    }
  },
  "scripts": {
    "prepare": "lefthook install",
    "start": "npm run dev",
    "dev": "npm-run-all --parallel dev:frontend dev:backend",
    "dev:frontend": "vite",
    "dev:backend": "convex dev --typecheck=disable",
    "predev": "convex dev --run init --until-success --typecheck=disable",
    "build": "tsc -b && vite build",
    "lint": "eslint . --ignore-pattern convex/_generated --report-unused-disable-directives",
    "typecheck": "tsc -p tsconfig.app.json && tsc -p tsconfig.node.json && tsc -p convex/tsconfig.json",
    "typecheck:portable": "node scripts/typecheck-portable.mjs",
    "preview": "vite preview",
    "status:watch": "node scripts/status/watch-status.mjs",
    "status:update": "node scripts/status/update-status.mjs",
    "status:event": "node scripts/status/push-event.mjs",
    "status:dashboard": "npm --prefix status-dashboard run dev",
    "test:e2e": "playwright test",
    "test:unit": "npm-run-all --serial --continue-on-error test:unit:convex test:unit:frontend",
    "test:unit:convex": "cd convex && vitest run",
    "test:unit:frontend": "vitest run --config ./vitest.frontend.config.ts",
    "test:manifests": "vitest run --config ./vitest.frontend.config.ts src/modules/manifest-dispatches.test.ts",
    "check:convex-codegen": "node scripts/check-convex-codegen.mjs",
    "check:convex-auth": "node scripts/check-convex-auth.mjs",
    "check:convex-db-reads": "node scripts/check-convex-db-reads.mjs",
    "migrations:check": "node scripts/supabase-migrations.mjs check",
    "migrations:apply": "node scripts/supabase-migrations.mjs apply",
    "test": "npm run test:unit && npm run test:e2e",
    "verify:jwt": "npx tsx scripts/verify-jwt-bridge.ts",
    "verify:s03": "npx tsx scripts/verify-s03-integration.ts",
    "verify:s04": "npx tsx scripts/verify-s04-contacts.ts",
    "migrate:contacts": "npx tsx scripts/migrate/run-contacts.ts",
    "migrate:validate": "npx tsx scripts/migrate/validate.ts",
    "verify:s05": "npx tsx scripts/verify-s05-migration.ts"
  },
  "dependencies": {
    "@auth/core": "^0.34.1",
